# Copy to .env for local development.

APP_NAME="Learning Platform API"
ENVIRONMENT=development
# DEBUG defaults to false in code; enabled here for local development only.
# With ENVIRONMENT=production the app refuses to boot if DEBUG=true.
DEBUG=true

# Local docker-compose Postgres (see docker-compose.yml at the repo root).
DATABASE_URL=postgresql+psycopg://learning_platform:learning_platform@localhost:5434/learning_platform

# Generate a real secret for anything beyond local dev. With
# ENVIRONMENT=production the app refuses to boot if this is the dev default
# below or shorter than 32 characters:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=dev-secret-key-change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_MINUTES=43200

# Allowed frontend origins: JSON array or comma-separated list. In production
# "*" is rejected at boot; list explicit origins.
CORS_ALLOW_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Optional overrides (JSON arrays); defaults are the minimum the app needs.
# CORS_ALLOW_METHODS=["GET","POST","PUT","PATCH","DELETE","OPTIONS"]
# CORS_ALLOW_HEADERS=["Authorization","Content-Type","Accept"]

# Rate limiting on /auth/login, /auth/register, /auth/refresh (in-memory, per
# process; returns 429). Per client IP, and per e-mail on login.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
# Set true ONLY behind a trusted reverse proxy (Railway) that sets
# X-Forwarded-For; otherwise clients can spoof their IP and dodge the limit.
TRUST_PROXY_HEADERS=false

# Registration policy. REGISTRATION_ENABLED=false closes signups (403).
# If REGISTRATION_INVITE_CODE is set, /auth/register requires it in the body.
REGISTRATION_ENABLED=true

# Logging. LOG_FORMAT=json emits one JSON object per line (timestamp, level,
# logger, message, request_id) for log aggregators; text is for local dev.
LOG_LEVEL=INFO
LOG_FORMAT=text
# Optional Sentry error reporting; needs `pip install ".[observability]"`.
# SENTRY_DSN=
# REGISTRATION_INVITE_CODE=

# AI layer (docs/ARCHITECTURE.md "AI layer"). AI_PROVIDER=fake is deterministic
# and needs no key. For the real provider set AI_PROVIDER=claude and put
# ANTHROPIC_API_KEY ONLY in the deploy environment (Railway variables) or your
# own uncommitted .env -- never in this file. With ENVIRONMENT=production,
# AI_PROVIDER=claude without a key refuses to boot.
AI_PROVIDER=fake
# ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2
# Hard cap on max_tokens of any single request.
AI_MAX_OUTPUT_TOKENS=4096
# Optional ceiling on tokens (input+output) per user per UTC day. 0 = off:
# usage is only measured (table ai_usage, GET /api/v1/ai/status).
AI_DAILY_TOKEN_LIMIT=0
