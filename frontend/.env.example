# Copy to .env for local development.
# Leave EMPTY (or unset) to call the API on the same origin: Vite proxies /api to
# the backend (see vite.config.ts) and Vercel rewrites /api in production
# (vercel.json), which keeps the HttpOnly refresh cookie first-party.
# Set it only to target a different origin (then the backend needs
# COOKIE_SAMESITE=none + COOKIE_SECURE=true, which modern browsers may block).
VITE_API_URL=
# Optional: where the dev/preview proxy forwards /api (default http://127.0.0.1:8000).
# API_PROXY_TARGET=http://127.0.0.1:8000
